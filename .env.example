# No-configuration Vercel demo: leave Environment Variables empty.
# Copy this file to .env.local only for local/real-service configuration.
# For a persistent Vercel demo, set only DATABASE_URL and DATABASE_AUTH_TOKEN.
DEMO_MODE=true
SAAS_ENABLED=false
LIVE_SENDS_ENABLED=false
APP_URL=http://localhost:3000

# Local SQLite is automatic. Use Turso for Vercel/serverless deployment.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Resend only emails the owner sign-in link; Meta sends Instagram DMs.
# Demo mode needs no email setup. Real owner sign-in currently requires Resend.
# Use your own verified sending domain; SMTP/passkey/password alternatives are not implemented.
OWNER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# New Meta apps: API setup with Unified Login. Set both values below.
# Existing Instagram Login apps: META_LOGIN_MODE=instagram and leave META_CONFIG_ID empty.
# Without a mode, adding META_CONFIG_ID selects Unified Login; otherwise Instagram Login.
META_LOGIN_MODE=unified
META_CONFIG_ID=
# Unified: Meta app ID/secret from App settings > Basic.
# Instagram Login: Instagram product ID/secret from its login setup.
# Creator and Business profiles are both professional accounts; Personal is unsupported.
# Follow docs/instagram-setup.md. Ahoy obtains the Instagram access token via OAuth.
# Do not paste a manually generated Instagram token here.
META_APP_ID=
META_APP_SECRET=
# A random string YOU choose, repeated in Meta webhook settings (not an access token).
META_VERIFY_TOKEN=
# Set a currently supported version from your Meta app dashboard (e.g. vXX.0).
META_API_VERSION=

# Inngest: add keys, then sync https://YOUR_APP_URL/api/inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Conservative local policy; validate current Meta limits before changing.
ACCOUNT_HOURLY_LIMIT=200
